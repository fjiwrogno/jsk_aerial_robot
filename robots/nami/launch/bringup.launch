<?xml version="1.0"?>
<launch>
  ###########  launch config  ###########
  <arg name="rm" default="True" />
  <arg name="sim" default="False" />
  <arg name="real_machine" default="$(arg rm)" />
  <arg name="simulation" default="$(arg sim)" />
  <arg name="control_mode" default="0" />
  <arg name="estimate_mode"  default= "1" />
  <arg name="sim_estimate_mode"  default= "2" />
  <arg name="headless" default="True" />
  <arg name="underwater" default="False" />
  <arg name="joystick" default="False" />
  <arg name="yaw_joint_init_deg" default="0.0" />
  <!-- uuv_gazebo_worlds is only needed for the underwater SIMULATION; a real
       machine (real_machine=true) must not resolve $(find uuv_gazebo_worlds) so
       it can run without uuv_simulator installed. -->
  <arg name="worldtype" default="$(find uuv_gazebo_worlds)/worlds/ocean_waves.world" if="$(eval arg('simulation') and arg('underwater'))" />
  <arg name="worldtype" default="$(find aerial_robot_simulation)/gazebo_model/world/empty.world" unless="$(eval arg('simulation') and arg('underwater'))" />
  <arg name="launch_gazebo" default="True" />
  <arg name="direct_model" default="False" />
  <arg name="direct_model_name" />
  <arg name="spawn_x" default="0.0"/>
  <arg name="spawn_y" default="0.0"/>
  <!-- Underwater: UUV buoyancy acts only while the body is below z=0, so spawn
       submerged; the slight positive buoyancy then floats the robot toward the
       surface instead of sinking. -->
  <arg name="spawn_z" default="0.0" unless="$(arg underwater)"/>
  <arg name="spawn_z" default="-1.0" if="$(arg underwater)"/>
  <arg name="spawn_yaw" default="0.0"/>
  <arg name="config_dir" default="$(find nami)/config"/>
  <arg name="robot_id" default="" />
  <arg name="robot_ns" value="nami$(arg robot_id)" />
  <arg name="airframe" default="quad" />

  ###########  Parameters  ###########
  <group ns="$(arg robot_ns)">
    # EGOMOTION_ESTIMATE = 0
    # EXPERIMENT_ESTIMATE = 1. for unstable mocap, use this mode
    # GROUND_TRUTH = 2

    ###########  Basic Param  ###########
    <param name="estimation/mode" value= "$(arg sim_estimate_mode)" if="$(arg simulation)" />
    <param name="estimation/mode" value= "$(arg estimate_mode)" if="$(arg real_machine)"/>

    ###########  Underwater Mode  ###########
    <param name="underwater_mode" value="$(arg underwater)" />

   ###########  Robot Model  ###########
   <rosparam file="$(arg config_dir)/RobotModel.yaml" command="load" />

   ###########  Motor Config  ###########
   <rosparam file="$(arg config_dir)/MotorInfoDShot.yaml" command="load" />

   ###########  Battery Config  ###########
   <rosparam file="$(arg config_dir)/Battery.yaml" command="load" />

   ###########  Servo Config  ###########
   <rosparam file="$(arg config_dir)/$(arg airframe)/Servo.yaml" command="load" />

   ###########  Control  ###########
   <rosparam file="$(arg config_dir)/$(arg airframe)/NamiControl.yaml" command="load" unless="$(arg simulation)"/>
   <rosparam file="$(arg config_dir)/$(arg airframe)/NamiControl_sim.yaml" command="load" if="$(arg simulation)"/>

   ###########  Sensor Fusion  ###########
   <rosparam file="$(arg config_dir)/StateEstimation.yaml" command="load" />
   <rosparam file="$(arg config_dir)/Simulation.yaml" command="load" if="$(eval arg('simulation') and not arg('real_machine'))"/>

   ###########  Navigation  ###########
   <param name="flight_navigation_plugin_name" value="aerial_robot_navigation/nami_navigation" />
   <rosparam file="$(arg config_dir)/NavigationConfig.yaml" command="load" />

  </group>

  ###########  Base Platform  ###########
  <node pkg="aerial_robot_base" type="aerial_robot_base_node" name="aerial_robot_base_node" ns="$(arg robot_ns)" output="screen" launch-prefix="$(optenv NAMI_LAUNCH_PREFIX)" >
    <param name="tf_prefix" value="$(arg robot_ns)"/>
    <param name="param_verbose" value="false"/>
    <param name="main_rate" value="40"/>
  </node>

  ###########  Robot Model  ###########
  <arg name="description_mode" value="urdf" unless="$(arg simulation)" />
  <arg name="description_mode" value="gazebo" if="$(eval arg('simulation') and not arg('underwater'))" />
  <arg name="description_mode" value="gazebo.underwater" if="$(eval arg('simulation') and arg('underwater'))" />
  <include file="$(find aerial_robot_model)/launch/aerial_robot_model.launch" >
    <arg name="headless" value="$(arg headless)" />
    <arg name="robot_model" value="$(find nami)/robots/$(arg airframe)/nami.$(arg description_mode).xacro"/>
    <arg name="robot_ns" value="$(arg robot_ns)" />
    <arg name="rviz_config" value="$(arg config_dir)/rviz_config" />
    <arg name="rviz_init_pose" value="$(arg config_dir)/RvizInit.yaml" />
    <arg name="need_joint_state" value="false" if ="$(eval arg('simulation') or arg('real_machine'))"/>
  </include >

  ###########  Servo Bridge  ###########
  <node pkg="aerial_robot_model" type="servo_bridge_node" name="servo_bridge" ns="$(arg robot_ns)" output="screen" />

  ###########  Hold the transformation joint at its initial angle  ###########
  <!-- Same node name as yaw_joint_transform.launch on purpose: launching that
       file replaces this one, so a shape change hands over without a step and
       nothing keeps yanking the joint back afterwards. -->
  <node pkg="nami" type="yaw_joint_commander.py" name="yaw_joint_commander"
        ns="$(arg robot_ns)" output="screen" if="$(arg real_machine)">
    <param name="target_angle_deg" value="$(arg yaw_joint_init_deg)" />
    <param name="duration" value="2.0" />
    <param name="hold_duration" value="-1.0" />
  </node>

  ##########  Sensors  ##########
  <include file="$(find nami)/launch/include/sensors.launch.xml" >
    <arg name="real_machine" value="$(arg real_machine)" />
    <arg name="simulation" value="$(arg simulation)" />
    <arg name="robot_ns" value="$(arg robot_ns)" />
    <arg name="underwater" value="$(arg underwater)" />
  </include >

  <!-- Optional underwater joystick input. Keyboard teleop remains a separate,
       always-available publisher on the same command interface. -->
  <include file="$(find aerial_robot_base)/launch/external_module/joy_stick.launch"
           if="$(eval arg('underwater') and arg('joystick'))">
    <arg name="robot_name" value="$(arg robot_ns)" />
  </include>

  ########## Simulation in Gazebo #########
  <!-- ocean_waves.world references model://ocean, model://ned_frame, model://sand_heightmap
       and file://Media/... material scripts - both env vars are required. -->
  <env name="GAZEBO_MODEL_PATH"
       value="$(find uuv_gazebo_worlds)/models:$(optenv GAZEBO_MODEL_PATH)"
       if="$(eval arg('simulation') and arg('underwater'))" />
  <env name="GAZEBO_RESOURCE_PATH"
       value="$(find uuv_gazebo_worlds):$(optenv GAZEBO_RESOURCE_PATH)"
       if="$(eval arg('simulation') and arg('underwater'))" />

  <include file="$(find aerial_robot_simulation)/launch/gazebo.launch" if = "$(eval arg('simulation') and not arg('real_machine'))" >
    <arg name="robot_ns" default="$(arg robot_ns)" />
    <arg name="gui" default="false" if="$(arg headless)"/>
    <arg name="headless" default="$(arg headless)" />
    <arg name="launch_gazebo" default="$(arg launch_gazebo)" />
    <arg name="worldtype" value="$(arg worldtype)" />
    <arg name="spawn_x" value="$(arg spawn_x)" />
    <arg name="spawn_y" value="$(arg spawn_y)" />
    <arg name="spawn_z" value="$(arg spawn_z)" />
    <arg name="spawn_yaw" value="$(arg spawn_yaw)" />
  </include>

</launch>
