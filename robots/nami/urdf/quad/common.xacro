<?xml version="1.0"?>
<robot
    xmlns:xacro="http://www.ros.org/wiki/xacro" name="nami_common" >

  <!-- general attribute -->
  <baselink name="fc" />
  <thrust_link name="thrust" />

  <m_f_rate value="-0.0068" /> <!-- drug torque rate -->
  <xacro:property name="max_force" value="18.2494" /> <!-- [N] -->
  <xacro:property name="min_force" value="1.0" /> <!-- [N] -->

  <!-- aquatic rotor (ApiSqueen X3, 24V): asymmetric bi-directional thrust range,
       endpoints taken from the convertBiDirectional table in dev/bi_directional_pwm -->
  <xacro:property name="aquatic_max_forward_force" value="25.48" /> <!-- [N] -->
  <xacro:property name="aquatic_max_reverse_force" value="14.7" /> <!-- [N] -->


  <!-- friction -->
  <xacro:macro name="friction" params="self">
    <gazebo reference="link${self}">
      <mu1>0.1</mu1>
      <mu2>0.1</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="damping_factor" params="link">
    <gazebo reference="${link}">
      <dampingFactor>0.00</dampingFactor>
    </gazebo>
  </xacro:macro>
</robot>
