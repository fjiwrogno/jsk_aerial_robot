# Raw RC channel frame from the SBUS-to-USB serial converter.
# Use the bool fields below for any failsafe/loss decision; "flags" is the raw
# converter byte kept for debugging (on link-loss frames generated by the
# driver, the failsafe/frame_lost bits are forced on so masks stay consistent).
# Until the first valid frame ever arrives, "channels" is all zero.
std_msgs/Header header
uint16[16] channels
uint8 flags
bool frame_lost
bool failsafe
